# Copy to .env.local (never commit .env.local). Every value here is a placeholder.

# Neon Postgres, DEMO database (pooled connection string). Without it the app keeps records in memory.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=verify-full

# Google AI Studio key (free tier, no billing linked) and the exact model id. Without both, the MOCK extractor is used.
GEMINI_API_KEY=your-ai-studio-key
GEMINI_MODEL=gemini-model-id-from-ai-studio
# Optional: GEMINI_API=interactions (default) or generate_content; GEMINI_THINKING_LEVEL=low (default), or "default".
# Optional: GEMINI_TIMEOUT_MS=60000 (default) per provider call, allowed 5000-90000.

# Tests only, in .env.test.local: the Neon TEST database (never the demo one).
# TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST/TESTDB?sslmode=verify-full

# Resend inbound email (phase H): API key and the webhook signing secret (starts with whsec_).
RESEND_API_KEY=re_placeholder
RESEND_WEBHOOK_SECRET=whsec_placeholder

# Demo seed profile: a real address you control, added as a registered sender for that vendor (comma-separated).
# DEMO_SENDER_V01=you@example.com
# DEMO_SENDER_V03=you@example.com
